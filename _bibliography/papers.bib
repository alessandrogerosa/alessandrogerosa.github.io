@article{giorgi_loop_2024,
  title = {The {Loop} of {Loops}: {The} {Recursive} {Dynamics} of {Videos} on {Social} {Media}},
  volume = {68},
  copyright = {All rights reserved},
  journal = {Lo Squaderno},
  author = {Giorgi, Giulia and Gerosa, Alessandro},
  year = {2024},
  note = {Publisher: Professionaldreamers},
  pages = {19--23},
  selected={false},
  abstract={After the global, outstanding success of the Chinese-owned TikTok in 2020, most social media platforms have adopted the short video format as their preferred way of engaging users and generat-ing content, such as Instagram Reels, YouTube Shorts and Facebook Watch. These videos are typically proposed to the user in dedicated sections of the platform, in the form of an endless flow of videos, categorised and distributed according to algorithmically calculated user preferences. The emergence of short videos marks a significant novelty compared to previously phases in social media led by image or textual content. Indeed, the new peculiar functioning of Tik Tok, based on memetic forms of imitation and replication rapidly adopted by other platforms, has been compared to the ‘end of the social networks’ as we knew them from the beginning of their story (The Economist, 2024). This brief piece critically discusses the algorithmically prompted recursive mechanism that underpins the ways in which social media platforms distribute visual content, and specifically short videos, to users.},
  html={https://doaj.org/article/f20dc50a8a904179a44a3dfc63ea142e},
  google_scholar_id={dhFuZR0502QC},
  annotation={The paper is published in Open Access},
  pdf={sq68.pdf},
  preview={sq68.jpg},
}

@article{gerosa_role_2025,
  title = {The role of proximity coworking spaces in the post-pandemic platform urbanism},
  volume = {29},
