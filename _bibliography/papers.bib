@incollection{gerosa_resurgence_2022,
  title = {The resurgence of craft retailing: marketing and branding strategies in the food and beverage sector},
  copyright = {All rights reserved},
  booktitle = {The {Artisan} {Brand}: {Entrepreneurship} and {Marketing} in {Contemporary} {Craft} {Economies}},
